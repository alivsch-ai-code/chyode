# Overrides für docker-compose.yml (deployment-spezifisch). Kopieren nach ".env" neben
# docker-compose.yml — docker compose lädt die Datei automatisch. Die echte ".env" niemals
# committen (ist gitignored).

NODE_ENV=production
FRONTEND_URL=https://your-domain.example
NEXT_PUBLIC_API_URL=https://your-domain.example/api

POSTGRES_PASSWORD=change-me
# Pflicht: mindestens 32 zufällige Zeichen, z. B. `openssl rand -hex 32`
JWT_SECRET=

# E-Mail-Versand (Einladungen, Passwort-Reset) über ein IONOS-Postfach.
# MAIL_FROM muss die Adresse des Postfachs sein (SMTP_USER).
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=info@your-domain.example
SMTP_PASS=
MAIL_FROM=info@your-domain.example
APP_NAME=Gruppen-Reiseplaner

RAPIDAPI_KEY=
BOOKING_RAPIDAPI_HOST=booking-com.p.rapidapi.com
AIRBNB_RAPIDAPI_HOST=airbnb13.p.rapidapi.com
GOOGLE_MAPS_API_KEY=
