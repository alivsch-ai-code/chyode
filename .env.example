# Overrides for docker-compose.yml (deployment-specific). Copy to ".env" next to
# docker-compose.yml — docker compose loads it automatically. Never commit the
# real ".env" (already gitignored).

NODE_ENV=production
FRONTEND_URL=https://your-domain.example
NEXT_PUBLIC_API_URL=https://your-domain.example/api

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# PoC-Schalter: gibt den Magic-Link direkt in der API-Antwort zurück statt ihn nur
# per Mail zu verschicken. Umgeht die E-Mail-Verifizierung — nur für Testbetrieb!
SHOW_AUTH_LINKS=false

RAPIDAPI_KEY=
BOOKING_RAPIDAPI_HOST=booking-com.p.rapidapi.com
AIRBNB_RAPIDAPI_HOST=airbnb13.p.rapidapi.com
GOOGLE_MAPS_API_KEY=
