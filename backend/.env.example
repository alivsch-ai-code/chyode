# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Datenbank
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripplanner

# Auth
JWT_SECRET=change-me-super-secret
MAGIC_LINK_TOKEN_TTL_MIN=30
CREATOR_SESSION_TTL_DAYS=30

# Externe APIs
RAPIDAPI_KEY=your-rapidapi-key
BOOKING_RAPIDAPI_HOST=booking-com.p.rapidapi.com
AIRBNB_RAPIDAPI_HOST=airbnb13.p.rapidapi.com
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Mailer (Magic Link) - im Dev-Modus wird der Link nur in die Konsole geloggt
MAIL_FROM=noreply@tripplanner.app
