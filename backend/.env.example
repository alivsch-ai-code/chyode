# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Datenbank
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripplanner

# Auth (in Produktion Pflicht: mindestens 32 zufällige Zeichen)
JWT_SECRET=dev-secret-change-me
SESSION_TTL_DAYS=7
INVITE_TTL_DAYS=7
PASSWORD_RESET_TTL_MIN=60

# E-Mail (IONOS-Postfach). Ohne SMTP_USER/SMTP_PASS werden Mails nur ins Log geschrieben.
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_NAME=Gruppen-Reiseplaner

# Externe APIs
RAPIDAPI_KEY=your-rapidapi-key
BOOKING_RAPIDAPI_HOST=booking-com.p.rapidapi.com
AIRBNB_RAPIDAPI_HOST=airbnb13.p.rapidapi.com
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
